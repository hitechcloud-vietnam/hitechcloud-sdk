<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>HiTechCloud.SDK</RootNamespace>
    <AssemblyName>HiTechCloud.SDK</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>HiTechCloud Vietnam</Authors>
    <Description>C# SDK for HiTechCloud UserAPI</Description>
    <PackageId>HiTechCloud.SDK</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/hitechcloud-vietnam/hitechcloud-sdk</RepositoryUrl>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.0" />
  </ItemGroup>

</Project>
