{
    "name": "hitechcloud/sdk",
    "description": "Official PHP SDK for HiTechCloud UserAPI",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "HiTechCloud",
            "email": "support@hitechcloud.vn"
        }
    ],
    "require": {
        "php": ">=8.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "HiTechCloud\\SDK\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HiTechCloud\\SDK\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
